# Nagar360 Environment Variables Configuration
# Default mode: DEMO MODE (Runs 100% locally out-of-the-box without requiring API keys)

# Next.js App Configuration
NEXT_PUBLIC_APP_NAME=Nagar360
NEXT_PUBLIC_DEFAULT_CITY=Chennai

# Supabase Configuration (Optional for Production Deployment)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini / Vision AI API Key (Optional for Server-side AI Vision Analysis)
GEMINI_API_KEY=your-gemini-api-key

# OpenStreetMap Nominatim User Agent
GEOCODE_USER_AGENT=Nagar360-Civic-App
